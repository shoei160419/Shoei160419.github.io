<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#08070d">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">

<title>MAGIA ACADEMY — Halloween Special</title>

<style>
:root{
  --bg:#08070d;
  --panel:#11101a;
  --panel2:#171521;
  --panel3:#0d0b13;
  --gold:#e8c77a;
  --gold2:#b9954c;
  --purple:#8f6bc7;
  --purple2:#5d4389;
  --text:#f6f1e5;
  --muted:#aaa4b5;
  --red:#a43d4b;
  --green:#7fc69a;
  --blue:#75b9e8;
  --line:#2c2838;
  --shadow:#000b;
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  background:
    radial-gradient(circle at 50% -10%,#30243f 0,#100d18 38%,#07060b 75%);
  color:var(--text);
  font-family:
    Georgia,
    "Times New Roman",
    "Hiragino Mincho ProN",
    serif;
  min-height:100vh;
}

button,
input,
select{
  font:inherit;
}

button{
  -webkit-tap-highlight-color:transparent;
}

.screen{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
}

.shell{
  width:min(820px,100%);
  min-height:calc(100vh - 48px);
  border:1px solid #40384d;
  background:
    linear-gradient(
      180deg,
      rgba(22,19,32,.97),
      rgba(8,7,13,.99)
    );
  box-shadow:
    0 20px 70px #000b,
    0 0 80px #6f4ba811;
  border-radius:22px;
  overflow:hidden;
  position:relative;
}

.hidden{
  display:none!important;
}

/* HEADER */

.top{
  padding:14px 18px;
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  background:#0d0b13e8;
  position:sticky;
  top:0;
  z-index:50;
  backdrop-filter:blur(14px);
}

.brand{
  letter-spacing:.12em;
  font-size:12px;
  color:var(--gold);
  white-space:nowrap;
}

.timer-wrap{
  display:flex;
  align-items:center;
  gap:8px;
}

.timer{
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
  font-weight:800;
  color:#fff;
  font-size:20px;
  letter-spacing:.04em;
}

.timer.warn{
  color:#ef7c7c;
  animation:pulseTimer 1s infinite;
}

.timer.danger{
  color:#ff465c;
  animation:pulseTimer .5s infinite;
}

@keyframes pulseTimer{
  50%{opacity:.45}
}

/* CONTENT */

.content{
  padding:30px 24px 42px;
}

.crest{
  font-size:64px;
  text-align:center;
  margin:18px;
  filter:drop-shadow(0 0 20px #8d6ac955);
}

.kicker{
  text-align:center;
  color:var(--gold);
  letter-spacing:.2em;
  font-size:11px;
  text-transform:uppercase;
}

.title{
  text-align:center;
  font-size:clamp(40px,9vw,78px);
  line-height:.95;
  letter-spacing:.08em;
  margin:10px 0 20px;
  text-shadow:0 0 30px #a57aef33;
}

.subtitle{
  text-align:center;
  color:var(--muted);
  margin:0 auto 30px;
  line-height:1.8;
}

h1,h2,h3{
  line-height:1.25;
}

h2{
  margin-top:8px;
}

.card{
  background:
    linear-gradient(
      180deg,
      #171420,
      #100e16
    );
  border:1px solid var(--line);
  border-radius:16px;
  padding:18px;
  margin:12px 0;
  box-shadow:0 10px 30px #0005;
}

.card.glow{
  border-color:#5b4677;
  box-shadow:
    0 0 0 1px #8c69ba22,
    0 15px 40px #0007,
    0 0 40px #7b54a611;
}

.card.gold{
  border-color:#6d572e;
}

.btn{
  display:block;
  width:100%;
  border:1px solid var(--gold2);
  background:
    linear-gradient(
      180deg,
      #3a2d42,
      #1b1722
    );
  color:var(--text);
  padding:14px 16px;
  border-radius:12px;
  cursor:pointer;
  transition:.2s;
  margin-top:12px;
  min-height:48px;
}

.btn:hover{
  transform:translateY(-1px);
  border-color:var(--gold);
  box-shadow:0 8px 24px #0008;
}

.btn:active{
  transform:translateY(0);
}

.btn.primary{
  background:
    linear-gradient(
      180deg,
      #8e7040,
      #5b4528
    );
  color:#fff9e9;
}

.btn.purple{
  background:
    linear-gradient(
      180deg,
      #684c8d,
      #342447
    );
  border-color:#9d78ce;
}

.btn.danger{
  border-color:#81404b;
  color:#f5a3aa;
}

.btn.ghost{
  background:#ffffff06;
  border-color:var(--line);
}

.btn.small{
  width:auto;
  display:inline-block;
  padding:9px 12px;
  min-height:auto;
  font-size:13px;
}

.btn:disabled{
  opacity:.4;
  cursor:not-allowed;
  transform:none;
  box-shadow:none;
}

.grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.grid3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.grid6{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.navgrid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.nav{
  min-height:108px;
  border:1px solid var(--line);
  background:#12101a;
  border-radius:15px;
  padding:15px;
  text-align:left;
  color:#fff;
  cursor:pointer;
  transition:.2s;
}

.nav:hover{
  border-color:#635174;
  background:#181522;
  transform:translateY(-1px);
}

.nav strong{
  display:block;
  color:var(--gold);
  margin-top:8px;
}

.nav small{
  color:var(--muted);
  display:block;
  margin-top:4px;
}

/* FORM */

.label{
  font-size:11px;
  color:var(--muted);
  letter-spacing:.12em;
  display:block;
}

.input{
  width:100%;
  padding:13px;
  border-radius:10px;
  border:1px solid var(--line);
  background:#090810;
  color:#fff;
  outline:none;
  margin-top:7px;
}

.input:focus{
  border-color:var(--gold2);
  box-shadow:0 0 0 3px #b9954c12;
}

select.input{
  color:#fff;
}

/* TEXT */

.role{
  font-size:20px;
  color:var(--gold);
  margin:6px 0;
}

.desc{
  color:#d0cad8;
  line-height:1.7;
  font-size:14px;
}

.center{
  text-align:center;
}

.big{
  font-size:28px;
}

.muted{
  color:var(--muted);
}

.good{
  color:var(--green);
}

.bad{
  color:#f07c86;
}

.blue{
  color:var(--blue);
}

.notice{
  border-left:3px solid var(--gold);
  padding:10px 12px;
  background:#fff5;
  color:#d9d1df;
  line-height:1.65;
  border-radius:0 8px 8px 0;
}

.warning{
  border-left-color:#b54a58;
  background:#a43d4b0c;
}

.tag{
  display:inline-block;
  border:1px solid #4a4057;
  border-radius:999px;
  padding:4px 9px;
  color:#c8bdd4;
  font-size:11px;
  margin:3px;
}

/* PROGRESS */

.progress{
  height:7px;
  background:#262230;
  border-radius:99px;
  overflow:hidden;
}

.progress i{
  display:block;
  height:100%;
  background:
    linear-gradient(
      90deg,
      #8f6bc7,
      var(--gold)
    );
  width:0;
  transition:width .4s;
}

/* MAP */

.maproom{
  padding:14px;
  border:1px solid var(--line);
  border-radius:12px;
  background:#0d0b13;
  text-align:center;
  min-height:92px;
  transition:.2s;
}

.maproom:not(.lock){
  cursor:pointer;
}

.maproom:not(.lock):hover{
  border-color:#69577d;
  background:#14111c;
  transform:translateY(-1px);
}

.maproom b{
  display:block;
  color:var(--gold);
  margin:6px 0 5px;
}

.lock{
  opacity:.45;
}

/* ITEMS */

.item{
  min-height:150px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}

.item.found{
  border-color:#665132;
}

.item.locked{
  opacity:.5;
}

/* QUEST */

.quest{
  border:1px solid var(--line);
  background:#0d0b13;
  border-radius:14px;
  padding:15px;
  margin:10px 0;
}

.quest.done{
  border-color:#55775f;
  background:#7fc69a08;
}

.quest-title{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
}

.check{
  color:var(--green);
  font-weight:bold;
}

/* ROLE */

.role-card{
  min-height:160px;
}

.role-icon{
  font-size:32px;
}

/* FINAL */

.final-rune{
  font-size:54px;
  letter-spacing:.12em;
  color:var(--gold);
  margin:20px 0;
  text-shadow:0 0 25px #e8c77a55;
}

.magic-circle{
  width:190px;
  height:190px;
  margin:20px auto;
  border:1px solid #9b79c855;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  box-shadow:
    0 0 40px #8f6bc722,
    inset 0 0 40px #8f6bc711;
}

.magic-circle:before{
  content:"";
  position:absolute;
  width:145px;
  height:145px;
  border:1px dashed #e8c77a66;
  border-radius:50%;
}

.magic-circle span{
  font-size:54px;
  position:relative;
  z-index:2;
}

/* TOAST */

.toast{
  position:fixed;
  left:50%;
  bottom:22px;
  transform:translateX(-50%);
  background:#15111d;
  border:1px solid #5c4b6d;
  padding:11px 16px;
  border-radius:999px;
  box-shadow:0 10px 30px #000a;
  z-index:200;
  max-width:90vw;
  text-align:center;
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  z-index:100;
  background:#000b;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.modal-box{
  width:min(560px,100%);
  max-height:90vh;
  overflow:auto;
  background:#11101a;
  border:1px solid #4a4057;
  border-radius:18px;
  padding:20px;
  box-shadow:0 30px 80px #000;
}

/* QR */

.scanner{
  border:1px solid var(--line);
  border-radius:14px;
  overflow:hidden;
  background:#050509;
  position:relative;
}

#qrVideo{
  width:100%;
  display:block;
  max-height:380px;
  object-fit:cover;
}

.scan-frame{
  position:absolute;
  inset:15%;
  border:2px solid var(--gold);
  box-shadow:
    0 0 0 999px #0005,
    0 0 25px #e8c77a55;
  pointer-events:none;
}

/* TABLE */

.code-table{
  width:100%;
  border-collapse:collapse;
  font-size:13px;
}

.code-table th,
.code-table td{
  border-bottom:1px solid var(--line);
  padding:10px 7px;
  text-align:left;
}

.code-table th{
  color:var(--gold);
}

/* FOOTER */

.footer{
  text-align:center;
  color:#777080;
  font-size:11px;
  padding:20px 0 0;
}

/* RESPONSIVE */

@media(max-width:600px){
  .screen{
    padding:0;
    align-items:stretch;
  }

  .shell{
    min-height:100vh;
    border-radius:0;
    border-left:0;
    border-right:0;
  }

  .content{
    padding:24px 16px 34px;
  }

  .grid6{
    grid-template-columns:repeat(2,1fr);
  }

  .grid3{
    grid-template-columns:repeat(2,1fr);
  }

  .navgrid{
    gap:9px;
  }

  .nav{
    min-height:100px;
    padding:13px;
  }

  .title{
    font-size:clamp(40px,13vw,70px);
  }

  .brand{
    font-size:10px;
  }

  .timer{
    font-size:17px;
  }
}

@media(max-width:380px){
  .grid,
  .navgrid{
    grid-template-columns:1fr;
  }

  .grid3,
  .grid6{
    grid-template-columns:1fr 1fr;
  }
}
</style>
</head>

<body>

<div id="app" class="screen">
  <div class="shell" id="shell"></div>
</div>

<script>
/* ============================================================
   MAGIA ACADEMY
   Halloween Special
   Standalone version
   ============================================================ */

const STORAGE_KEY = "magia_academy_v2";

const roles = {
  star:{
    icon:"🔮",
    name:"星読み師",
    en:"ASTROLOGER",
    color:"#a987df",
    desc:"星・数字・時間に関する特別な情報を読み取る。",
    secret:"星の塔で見つけた古い記録には「夜の三番目に光るもの」という一文がある。",
    fragment:"星"
  },

  alchemy:{
    icon:"🧪",
    name:"錬金術師",
    en:"ALCHEMIST",
    color:"#70c9a0",
    desc:"薬品・色・組み合わせに関する情報を扱う。",
    secret:"銀色の薬瓶には「最初に月、次に星、最後に太陽」と刻まれている。",
    fragment:"薬"
  },

  beast:{
    icon:"🦉",
    name:"魔法生物学者",
    en:"BEAST KEEPER",
    color:"#b8a168",
    desc:"生き物・図形・探索に関する情報を見つける。",
    secret:"黒い羽根を持つフクロウは、本館の東側を向いていた。",
    fragment:"羽"
  },

  archive:{
    icon:"📜",
    name:"古代魔法研究者",
    en:"ARCHIVIST",
    color:"#d5a878",
    desc:"古代文字・文章・歴史に関する情報を解読する。",
    secret:"禁書庫の古文書に「始まりは月、導きは星、帰還は太陽」とある。",
    fragment:"古"
  },

  spell:{
    icon:"🪄",
    name:"呪文使い",
    en:"SPELL CASTER",
    color:"#9c8fe1",
    desc:"言葉・音・発音・並びに関する情報を扱う。",
    secret:"卒業呪文の最初の音は「ル」。",
    fragment:"呪"
  },

  seer:{
    icon:"👁️",
    name:"予言者",
    en:"SEER",
    color:"#8eb7df",
    desc:"パターン・未来・推理に関する情報を見抜く。",
    secret:"最後の扉に刻まれた予言は「六つの断片が揃った時、扉は開く」。",
    fragment:"門"
  }
};

const defaultState = {
  screen:"home",
  team:"",
  player:"",
  role:"star",
  started:false,
  time:1800,
  solved:0,
  items:[],
  discoveredCodes:[],
  quests:{},
  hintsUsed:0,
  finalUnlocked:false,
  graduated:false,
  notificationAsked:false,
  startedAt:null
};

let state = {...defaultState};
let timerInterval = null;
let scannerStream = null;
let scannerInterval = null;

load();

/* ============================================================
   STORAGE
   ============================================================ */

function save(){
  const copy = {...state};
  localStorage.setItem(STORAGE_KEY,JSON.stringify(copy));
}

function load(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);

    if(raw){
      state = {
        ...defaultState,
        ...JSON.parse(raw)
      };
    }
  }catch(e){
    console.warn("Save data could not be loaded.",e);
  }
}

/* ============================================================
   BASIC HELPERS
   ============================================================ */

function shell(){
  return document.getElementById("shell");
}

function fmt(seconds){
  seconds = Math.max(0,Number(seconds)||0);

  return (
    String(Math.floor(seconds/60)).padStart(2,"0")
    + ":"
    + String(seconds%60).padStart(2,"0")
  );
}

function esc(value){
  return String(value ?? "").replace(
    /[&<>"']/g,
    m=>({
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#39;"
    }[m])
  );
}

function progressPercent(){
  return Math.min(100,state.solved * 25);
}

/* ============================================================
   NAVIGATION
   ============================================================ */

function go(screen){
  stopScanner();
  state.screen = screen;
  save();
  render();
  window.scrollTo({top:0,behavior:"smooth"});
}

/* ============================================================
   HEADER
   ============================================================ */

function header(){

  if(!state.started){
    return "";
  }

  let timerClass = "";

  if(state.time <= 60){
    timerClass = "danger";
  }else if(state.time <= 300){
    timerClass = "warn";
  }

  return `
    <div class="top">
      <div class="brand">
        🪄 MAGIA ACADEMY
      </div>

      <div class="timer-wrap">
        <span class="muted">残り</span>
        <div class="timer ${timerClass}" id="timer">
          ${fmt(state.time)}
        </div>
      </div>
    </div>
  `;
}

/* ============================================================
   RENDER
   ============================================================ */

function render(){

  let body = "";

  switch(state.screen){

    case "home":
      body = homePage();
      break;

    case "about":
      body = aboutPage();
      break;

    case "enroll":
      body = enrollPage();
      break;

    case "role":
      body = rolePage();
      break;

    case "game":
      body = gamePage();
      break;

    case "map":
      body = mapPage();
      break;

    case "archive":
      body = archivePage();
      break;

    case "items":
      body = itemsPage();
      break;

    case "quests":
      body = questsPage();
      break;

    case "exam":
      body = examPage();
      break;

    case "qr":
      body = qrPage();
      break;

    case "hint":
      body = hintPage();
      break;

    case "final":
      body = finalPage();
      break;

    case "grad":
      body = gradPage();
      break;

    case "settings":
      body = settingsPage();
      break;

    default:
      body = homePage();
  }

  shell().innerHTML = header() + body;

  updateTimer();
}

/* ============================================================
   HOME
   ============================================================ */

function homePage(){

  return `
    <div class="content center">

      <div class="crest">🦉</div>

      <div class="kicker">
        Halloween Special
      </div>

      <h1 class="title">
        MAGIA<br>ACADEMY
      </h1>

      <p class="subtitle">
        迷い込んだ先は、卒業しなければ帰れない魔法学校だった。<br>
        <b>30 MINUTES TO GRADUATE.</b>
      </p>

      <button class="btn primary" onclick="go('enroll')">
        🎓 入学する
      </button>

      <button class="btn ghost" onclick="go('about')">
        世界観を見る
      </button>

      <button class="btn ghost" onclick="resumeGame()">
        📖 前回の続き
      </button>

      <div class="footer">
        MAGIA ACADEMY / HALLOWEEN SPECIAL
      </div>

    </div>
  `;
}

/* ============================================================
   ABOUT
   ============================================================ */

function aboutPage(){

  return `
    <div class="content">

      <div class="kicker">The Story</div>

      <h2>
        30分後、あなたは魔法使いになっている。
      </h2>

      <div class="card glow">

        <p class="desc">
          ハロウィンの夜、あなたたちは大学キャンパスにある
          古い扉を開いてしまった。
          次の瞬間、そこは魔法学院
          「MAGIA ACADEMY」だった。
        </p>

        <p class="desc">
          元の世界へ帰る方法はひとつ。
          6人全員で卒業試験を突破し、
          失われた卒業魔法を完成させること。
        </p>

        <div class="notice">
          キャンパスに隠された情報を探し、
          QRコードや謎を解き、
          6人それぞれが持つ秘密の情報を
          最後に一つへつなげよう。
        </div>

      </div>

      <div class="grid">

        <div class="card center">
          <div class="big">⏱️</div>
          <b>30 MINUTES</b>
          <p class="muted">時間制限</p>
        </div>

        <div class="card center">
          <div class="big">👥</div>
          <b>6 ROLES</b>
          <p class="muted">6つの魔法適性</p>
        </div>

        <div class="card center">
          <div class="big">🗺️</div>
          <b>EXPLORE</b>
          <p class="muted">キャンパス探索</p>
        </div>

        <div class="card center">
          <div class="big">👑</div>
          <b>GRADUATE</b>
          <p class="muted">卒業試験</p>
        </div>

      </div>

      <button class="btn primary" onclick="go('enroll')">
        入学手続きへ
      </button>

      <button class="btn ghost" onclick="go('home')">
        ← 戻る
      </button>

    </div>
  `;
}

/* ============================================================
   ENROLL
   ============================================================ */

