      ${
        solved
        ?
        `
          <div class="card glow center">

            <div class="big">✨</div>

            <h3 class="good">
              CLEAR
            </h3>

            <p class="desc">
              第一魔法試験は突破済みです。
            </p>

          </div>
        `
        :
        `
          <div class="card">

            <p class="desc">
              【第一試験】
            </p>

            <p>
              古い校章には、
              <b>月・星・太陽</b>
              の3つの印が刻まれている。
            </p>

            <p>
              魔法書には
              <b>「夜から朝へ」</b>
              と記されている。
            </p>

            <p>
              正しい順番で印を並べてください。
            </p>

            <div class="grid">

              <button
                class="btn ghost"
                onclick="answerExam(1)"
              >
                🌙 → ⭐ → ☀️
              </button>

              <button
                class="btn ghost"
                onclick="answerExam(0)"
              >
                ☀️ → ⭐ → 🌙
              </button>

              <button
                class="btn ghost"
                onclick="answerExam(0)"
              >
                ⭐ → ☀️ → 🌙
              </button>

              <button
                class="btn ghost"
                onclick="answerExam(0)"
              >
                🌙 → ☀️ → ⭐
              </button>

            </div>

          </div>
        `
      }

      <div class="card">

        <div class="notice">
          ヒント：
          「夜から朝へ」という言葉を
          時間の流れとして考えてみよう。
        </div>

      </div>

      <button class="btn ghost" onclick="go('game')">
        ← 戻る
      </button>

    </div>
  `;
}

function answerExam(correct){

  if(!correct){

    toast(
      "🪄 魔法が不安定です。もう一度考えてみよう。"
    );

    return;
  }

  if(state.solved < 1){
    state.solved = 1;
  }

  const already =
    state.items.some(
      x=>x.title==="第一試験の記録"
    );

  if(!already){

    state.items.push({
      title:"第一試験の記録",
      body:
        "校章の順序を解読した。『夜から朝へ』＝月 → 星 → 太陽。",
      icon:"🧩"
    });

  }

  save();

  toast(
    "✨ 試験突破！魔法書に記録しました。"
  );

  setTimeout(()=>{
    render();
  },300);
}

/* ============================================================
   HINT
   ============================================================ */

function hintPage(){

  const used =
    state.hintsUsed;

  return `
    <div class="content">

      <div class="kicker">
        Professor's Hint
      </div>

      <h2>💡 教師のヒント</h2>

      <div class="card">

        <p class="desc">
          ヒントは段階的に開放されます。
          本番では運営スタッフがチームごとに
          ヒントを解放する設計にもできます。
        </p>

      </div>

      <div class="quest">

        <b>HINT 1 — 無料</b>

        ${
          used >= 1
          ?
          `<p class="desc">
            数字だけではなく、
            周りの記号にも意味があります。
          </p>`
          :
          `<button
            class="btn ghost"
            onclick="useHint(1)"
          >
            ヒントを見る
          </button>`
        }

      </div>

      <div class="quest">

        <b>HINT 2 — もう一歩</b>

        ${
          used >= 2
          ?
          `<p class="desc">
            「夜から朝へ」という言葉に
            注目してください。
          </p>`
          :
          `<button
            class="btn ghost"
            ${used<1?"disabled":""}
            onclick="useHint(2)"
          >
            ヒントを見る
          </button>`
        }

      </div>

      <div class="quest">

        <b>HINT 3 — かなり具体的</b>

        ${
          used >= 3
          ?
          `<p class="desc">
            夜 → 月、
            夜空 → 星、
            朝 → 太陽。
            順序をそのまま並べます。
          </p>`
          :
          `<button
            class="btn ghost"
            ${used<2?"disabled":""}
            onclick="useHint(3)"
          >
            ヒントを見る
          </button>`
        }

      </div>

      <button class="btn ghost" onclick="go('game')">
        ← 戻る
      </button>

    </div>
  `;
}

function useHint(n){

  if(n > state.hintsUsed + 1){
    toast("先のヒントはまだ開放されていません。");
    return;
  }

  state.hintsUsed = Math.max(
    state.hintsUsed,
    n
  );

  save();

  render();
}

/* ============================================================
   FINAL
   ============================================================ */

function finalPage(){

  const discovered =
    state.discoveredCodes.length;

  const enough =
    discovered >= 6 &&
    state.solved >= 1;

  const role =
    roles[state.role];

  return `
    <div class="content center">

      <div class="kicker">
        Final Examination
      </div>

      <div class="magic-circle">
        <span>👑</span>
      </div>

      <h2>
        卒業試験
      </h2>

      <div class="card">

        <p class="desc">
          ここは6人全員の情報を統合する
          最終ステージです。
        </p>

        <p class="desc">
          6人それぞれの魔導片を持ち寄り、
          最後の魔法を完成させてください。
        </p>

      </div>

      <div class="grid">

        <div class="card">
          <b>魔法記録</b>
          <p class="big">
            ${discovered}/6
          </p>
          <small class="muted">
            QR記録
          </small>
        </div>

        <div class="card">
          <b>試験</b>
          <p class="big">
            ${state.solved}/4
          </p>
          <small class="muted">
            クリア
          </small>
        </div>

      </div>

      <div class="card gold">

        <div class="kicker">
          YOUR FRAGMENT
        </div>

        <div class="final-rune">
          ${role.fragment}
        </div>

        <p class="muted">
          ${role.name}の魔導片
        </p>

      </div>

      ${
        enough
        ?
        `
          <div class="card glow">

            <div class="notice">
              六つの記録が揃いました。
              最終魔法を発動できます。
            </div>

            <button
              class="btn primary"
              onclick="castFinalSpell()"
            >
              ✨ 最終魔法を唱える
            </button>

          </div>
        `
        :
        `
          <div class="card">

            <div class="notice warning">
              まだ卒業魔法の条件を
              満たしていません。<br><br>

              必要条件：<br>
              ・6つの魔法記録<br>
              ・第一魔法試験クリア
            </div>

          </div>
        `
      }

      <button class="btn ghost" onclick="go('game')">
        ← 戻る
      </button>

    </div>
  `;
}

function castFinalSpell(){

  if(
    state.discoveredCodes.length < 6 ||
    state.solved < 1
  ){

    toast(
      "まだ魔法の材料が足りません。"
    );

    return;
  }

  state.finalUnlocked = true;
  save();

  go("grad");
}

/* ============================================================
   GRADUATION
   ============================================================ */

function gradPage(){

  if(!state.finalUnlocked){
    go("final");
    return "";
  }

  state.graduated = true;
  save();

  if(timerInterval){
    clearInterval(timerInterval);
    timerInterval = null;
  }

  return `
    <div class="content center">

      <div class="crest">
        🎓
      </div>

      <div class="kicker">
        Graduation Approved
      </div>

      <h1
        class="title"
        style="font-size:52px"
      >
        GRADUATED
      </h1>

      <p class="subtitle">
        おめでとうございます、
        ${esc(state.player)}。<br>
        あなたは
        <b>MAGIA ACADEMY</b>
        を卒業しました。
      </p>

      <div class="card glow">

        <div class="big">
          🏆
        </div>

        <h2>
          TEAM ${String(state.team).padStart(2,"0")}
        </h2>

        <p class="good">
          卒業資格：認定
        </p>

        <p class="muted">
          魔法適性：
          ${roles[state.role].name}
        </p>

        <p class="muted">
          取得魔導片：
          ${roles[state.role].fragment}
        </p>

      </div>

      <div class="card">

        <div class="final-rune">
          月 → 星 → 太陽
        </div>

        <p class="desc">
          失われた卒業魔法は復元された。
          校門が開き、あなたたちは
          元の世界へ帰ることができる。
        </p>

      </div>

      <button
        class="btn primary"
        onclick="showCertificate()"
      >
        📜 卒業証書を見る
      </button>

      <button
        class="btn ghost"
        onclick="resetGame(true)"
      >
        もう一度プレイ
      </button>

    </div>
  `;
}

function showCertificate(){

  const modal =
    document.createElement("div");

  modal.className = "modal";

  modal.innerHTML = `

    <div class="modal-box center">

      <div class="crest">
        🦉
      </div>

      <div class="kicker">
        MAGIA ACADEMY
      </div>

      <h2>
        卒業証書
      </h2>

      <p class="desc">
        ${esc(state.player)} 殿
      </p>

      <div class="card gold">

        <h3>
          MAGIA ACADEMY
        </h3>

        <p>
          魔法学院卒業資格
        </p>

        <p class="good">
          正式認定
        </p>

        <small class="muted">
          TEAM ${String(state.team).padStart(2,"0")}
        </small>

      </div>

      <button
        class="btn primary"
        onclick="this.closest('.modal').remove()"
      >
        閉じる
      </button>

    </div>

  `;

  document.body.appendChild(modal);
}

/* ============================================================
   SETTINGS
   ============================================================ */

function settingsPage(){

  const notificationStatus =
    "Notification" in window
      ? Notification.permission
      : "unsupported";

  return `
    <div class="content">

      <div class="kicker">
        Academy Settings
      </div>

      <h2>⚙️ 設定</h2>

      <div class="card">

        <b>🔔 デスクトップ通知</b>

        <p class="muted">
          現在：
          ${notificationStatus}
        </p>

        <button
          class="btn ghost"
          onclick="enableNotifications()"
        >
          通知を許可する
        </button>

      </div>

      <div class="card">

        <b>💾 セーブデータ</b>

        <p class="muted">
          現在の進行状況は
          このブラウザに保存されています。
        </p>

        <button
          class="btn danger"
          onclick="confirmReset()"
        >
          セーブデータを削除
        </button>

      </div>

      <div class="card">

        <b>MAGIA ACADEMY</b>

        <p class="muted">
          Halloween Special<br>
          Standalone Edition
        </p>

      </div>

      <button class="btn ghost" onclick="go('game')">
        ← 戻る
      </button>

    </div>
  `;
}

/* ============================================================
   RESET / RESUME
   ============================================================ */

function confirmReset(){

  const ok =
    confirm(
      "現在のゲーム進行をすべて削除します。\nよろしいですか？"
    );

  if(ok){
    resetGame(false);
  }
}

function resetGame(returnHome){

  stopScanner();

  if(timerInterval){
    clearInterval(timerInterval);
    timerInterval = null;
  }

  state = {
    ...defaultState
  };

  localStorage.removeItem(STORAGE_KEY);

  if(returnHome){
    render();
  }else{
    go("home");
  }
}

function resumeGame(){

  if(
    !state.started ||
    !state.player
  ){

    toast(
      "保存されたゲームデータがありません。"
    );

    setTimeout(()=>{
      go("enroll");
    },500);

    return;
  }

  startTimer();
  go(state.graduated ? "grad" : "game");
}

/* ============================================================
   TOAST
   ============================================================ */

function toast(message){

  const old =
    document.querySelector(".toast");

  if(old){
    old.remove();
  }

  const x =
    document.createElement("div");

  x.className = "toast";
  x.textContent = message;

  document.body.appendChild(x);

  setTimeout(()=>{
    x.remove();
  },2500);
}

/* ============================================================
   KEYBOARD SHORTCUTS
   ============================================================ */

document.addEventListener("keydown",e=>{

  if(e.key === "Escape"){
    stopScanner();
  }

});

/* ============================================================
   START
   ============================================================ */

render();

if(
  state.started &&
  !state.graduated &&
  state.time > 0
){
  startTimer();
}

</script>

</body>
</html>
