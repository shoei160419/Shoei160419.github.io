async function startScanner(){

  if(!("BarcodeDetector" in window)){

    toast(
      "このブラウザはQRカメラ読み取りに未対応です。コード入力をご利用ください。"
    );

    return;
  }

  try{

    const detector =
      new BarcodeDetector({
        formats:["qr_code"]
      });

    scannerStream =
      await navigator.mediaDevices.getUserMedia({
        video:{
          facingMode:{
            ideal:"environment"
          }
        },
        audio:false
      });

    const video =
      document.getElementById("qrVideo");

    if(!video){
      return;
    }

    video.srcObject = scannerStream;

    await video.play();

    document
      .getElementById("scannerBox")
      ?.classList.remove("hidden");

    document
      .getElementById("scanBtn")
      ?.classList.add("hidden");

    document
      .getElementById("stopScanBtn")
      ?.classList.remove("hidden");

    scannerInterval =
      setInterval(async()=>{

        try{

          const codes =
            await detector.detect(video);

          if(codes.length){

            const value =
              codes[0].rawValue;

            document.getElementById(
              "qrCodeInput"
            ).value = value;

            redeemQRCode();

            stopScanner();
          }

        }catch(e){
          console.warn(e);
        }

      },500);

  }catch(e){

    console.error(e);

    toast(
      "カメラを起動できませんでした。HTTPSまたはカメラ許可を確認してください。"
    );
  }
}

function stopScanner(){

  if(scannerInterval){
    clearInterval(scannerInterval);
    scannerInterval = null;
  }

  if(scannerStream){

    scannerStream
      .getTracks()
      .forEach(track=>track.stop());

    scannerStream = null;
  }

  const video =
    document.getElementById("qrVideo");

  if(video){
    video.srcObject = null;
  }
}

function redeemQRCode(){

  const input =
    document.getElementById("qrCodeInput");

  if(!input){
    return;
  }

  const code =
    input.value
      .trim()
      .toUpperCase();

  const data =
    qrData[code];

  if(!data){

    toast(
      "🪄 魔法コードが認識できません。"
    );

    return;
  }

  if(state.discoveredCodes.includes(code)){

    toast(
      "📖 この魔法記録はすでに解読済みです。"
    );

    return;
  }

  state.discoveredCodes.push(code);

  state.items.push({
    title:data.title,
    body:data.body,
    icon:data.item
  });

  save();

  toast(
    `✨ ${data.title}を魔法書に追加しました。`
  );

  render();
}

