/* ============================================================
   TIMER
   ============================================================ */

function startTimer(){

  if(timerInterval){
    return;
  }

  timerInterval = setInterval(()=>{

    if(!state.started || state.graduated){
      return;
    }

    if(state.time > 0){

      state.time--;

      updateTimer();

      if(state.time === 300){
        notify(
          "🕯️ MAGIA ACADEMY",
          "残り5分です。卒業魔法を完成させてください。"
        );

        toast("🕯️ 残り5分！");
      }

      if(state.time === 60){
        notify(
          "⚠️ MAGIA ACADEMY",
          "残り1分です。最終試験へ急いでください。"
        );

        toast("⚠️ 残り1分！");
      }

      save();

    }else{

      clearInterval(timerInterval);
      timerInterval = null;

      notify(
        "⏳ MAGIA ACADEMY",
        "最終ベルが鳴りました。制限時間終了です。"
      );

      toast("⏳ 最終ベルが鳴りました。");

    }

  },1000);
}

function updateTimer(){

  const timer = document.getElementById("timer");

  if(!timer){
    return;
  }

  timer.textContent = fmt(state.time);

  timer.classList.remove(
    "warn",
    "danger"
  );

  if(state.time <= 60){
    timer.classList.add("danger");
  }else if(state.time <= 300){
    timer.classList.add("warn");
  }
}

/* ============================================================
   NOTIFICATION
   ============================================================ */

async function enableNotifications(){

  if(!("Notification" in window)){
    return false;
  }

  if(Notification.permission === "granted"){
    state.notificationAsked = true;
    return true;
  }

  if(Notification.permission === "denied"){
    return false;
  }

  try{

    const permission =
      await Notification.requestPermission();

    state.notificationAsked = true;

    if(permission === "granted"){
      toast("🔔 デスクトップ通知を有効にしました。");
      return true;
    }

  }catch(e){
    console.warn(e);
  }

  return false;
}

function notify(title,body){

  if(
    "Notification" in window &&
    Notification.permission === "granted"
  ){

    try{

      new Notification(title,{
        body:body,
        icon:"data:image/svg+xml;charset=UTF-8," +
          encodeURIComponent(`
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="128"
              height="128"
            >
              <rect
                width="128"
                height="128"
                rx="24"
                fill="#171420"
              />
              <text
                x="64"
                y="84"
                text-anchor="middle"
                font-size="62"
              >
                🦉
              </text>
            </svg>
          `)
      });

    }catch(e){
      console.warn(e);
    }
  }
}

